# MetricCupid Push Relay configuration. Copy to .env and fill in.
# Placeholders only. Never commit a real .env.

# --- v1: Pushover relay (optional; leave all three unset to run v2 only) ---
# Pushover application API token (https://pushover.net/apps/build)
PUSHOVER_APP_TOKEN=replace-with-your-app-token
# Pushover user or group key
PUSHOVER_USER_KEY=replace-with-your-user-key
# Comma-separated relay secrets, each at least 32 characters.
# Generate one with: openssl rand -hex 32
# Several secrets allow rotation without downtime.
RELAY_SECRETS=CHANGE_ME_openssl_rand_hex_32

# --- network ---
BIND=0.0.0.0:8080
# none | cloudflare | xff:<cidr>[,<cidr>...]
TRUST_PROXY=none
# With TRUST_PROXY=cloudflare: fetch current ranges at startup (falls back to built-in list)
CF_REFRESH=false
# With TRUST_PROXY=cloudflare: extra trusted ranges, e.g. the compose network for cloudflared
# CF_IPS_EXTRA=172.30.53.0/24

# --- behaviour ---
# selfhosted | hosted (hosted: /v1/notify returns 501, v2 licence gate + gateway endpoint)
MODE=selfhosted
# Allow Pushover priority 2 (emergency, repeats until acknowledged)
ALLOW_EMERGENCY=false
# Drop repeats of the same dedup_key within this many seconds (0 = off)
DEDUP_WINDOW_SECS=300
# When Pushover's remaining monthly quota drops below this, only priority >= 1 passes
QUOTA_RESERVE=500

# --- rate limits (requests per second / burst) ---
RATE_GLOBAL_PER_SEC=50
RATE_GLOBAL_BURST=100
RATE_IP_PER_SEC=5
RATE_IP_BURST=20
RATE_SECRET_PER_SEC=2
RATE_SECRET_BURST=30
# Ban an IP after this many auth failures within the window
AUTH_BAN_THRESHOLD=10
AUTH_BAN_WINDOW_SECS=900
AUTH_BAN_SECS=900

# --- v2: MetricCupid Push (see PROTOCOL.md) ---
# direct | gateway | mock. gateway (default for selfhosted) pushes through the hosted gateway.
APNS_MODE=gateway
# GATEWAY_URL=https://push-metriccupid.sysop.cat
# Hosted only: relay APNs for self-hosted servers (off = 403 gateway_closed).
# GATEWAY_OPEN=false
# SQLite database directory (a volume in docker-compose.yml)
DATA_DIR=/data
# With APNS_MODE=direct only (your own Apple key for the app's bundle id):
# APNS_KEY_P8=/run/secrets/AuthKey_ABCDE12345.p8
# APNS_KEY_ID=ABCDE12345
# APNS_TEAM_ID=TEAM123456
# APNS_TOPIC=cat.sysop.MetricCupid
# MODE=hosted only: App Store licences (PROTOCOL.md section 13).
# LICENCE_MODE=app_transaction        # or `open` (= HOSTED_OPEN_REGISTRATION=true)
# LICENCE_ALLOW_SANDBOX=true          # accept TestFlight purchases
# LICENCE_MAX_GROUPS=3
# LICENCE_GRACE_UNTIL=2026-11-16      # unlicensed beta groups may send until then
# Per-group / per-IP limits
RATE_V2_MESSAGES_PER_SEC=2
RATE_V2_MESSAGES_BURST=60
RATE_V2_COMMANDS_PER_SEC=1
RATE_V2_COMMANDS_BURST=20
RATE_V2_GATEWAY_PER_SEC=5
RATE_V2_GATEWAY_BURST=50
RATE_V2_GROUPS_PER_HOUR=6
RATE_V2_GROUPS_BURST=3
# WebSocket ping interval (keep well below Cloudflare's ~100 s idle timeout)
WS_PING_SECS=30

# --- admin panel (optional; README "Admin panel") ---
# Separate listener; never publish this port. Create the values with:
#   docker run --rm -it ghcr.io/dzaczek/metriccupid-push admin-setup
# ADMIN_BIND=0.0.0.0:8081
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$replace$replace'
# ADMIN_TOTP_SECRET=REPLACEWITHBASE32SECRETFROMADMINSETUP
# Real client IPs (via TRUST_PROXY) allowed to see the panel; empty = panel refused
# ADMIN_ALLOW_IPS=203.0.113.7/32,2001:db8:1234::/48
# ADMIN_ALLOW_ANY=false
# ADMIN_SESSION_HOURS=12
# ADMIN_EVENTS_RETENTION_DAYS=30

# --- logging ---
# text | json
LOG_FORMAT=text
# error | warn | info | debug | trace
LOG_LEVEL=info

# --- Cloudflare Tunnel (docker compose --profile tunnel) ---
# TUNNEL_TOKEN=replace-with-your-tunnel-token

# --- tests only ---
# PUSHOVER_API_URL=https://api.pushover.net/1/messages.json
# APNS_PRODUCTION_URL=https://api.push.apple.com
# APNS_SANDBOX_URL=https://api.sandbox.push.apple.com
